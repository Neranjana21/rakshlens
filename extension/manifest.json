{
  "manifest_version": 3,
  "name": "RakshaLens – check before you pay",
  "version": "0.1.0",
  "description": "Select a message or right-click a link to check it for investment-scam warning signs. Nothing is saved.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["contextMenus", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "RakshaLens" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
